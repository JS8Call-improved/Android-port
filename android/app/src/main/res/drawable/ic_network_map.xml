<?xml version="1.0" encoding="utf-8"?>
<!-- A hub with three spokes: center node at (12,13), satellites at
     (5,5), (19,5), (12,21). Lines drawn as stroked paths, nodes as
     circles built from two half-circle arcs. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24"
    android:tint="?attr/colorControlNormal">
    <path
        android:strokeColor="@android:color/white"
        android:strokeWidth="1.6"
        android:pathData="M12,13 L5,5 M12,13 L19,5 M12,13 L12,21" />
    <path
        android:fillColor="@android:color/white"
        android:pathData="M12,13 m-2.6,0 a2.6,2.6 0 1,0 5.2,0 a2.6,2.6 0 1,0 -5.2,0" />
    <path
        android:fillColor="@android:color/white"
        android:pathData="M5,5 m-2,0 a2,2 0 1,0 4,0 a2,2 0 1,0 -4,0" />
    <path
        android:fillColor="@android:color/white"
        android:pathData="M19,5 m-2,0 a2,2 0 1,0 4,0 a2,2 0 1,0 -4,0" />
    <path
        android:fillColor="@android:color/white"
        android:pathData="M12,21 m-2,0 a2,2 0 1,0 4,0 a2,2 0 1,0 -4,0" />
</vector>
