<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <!-- Waterfall View -->
    <com.js8call.example.ui.WaterfallView
        android:id="@+id/waterfall_view"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="@dimen/monitor_waterfall_weight"
        android:background="@color/waterfall_background" />

    <!-- Status strip -->
    <include
        layout="@layout/monitor_status_card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <!-- Embedded decode list -->
    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/decode_pane"
        android:name="com.js8call.example.ui.DecodeFragment"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="@dimen/monitor_decodes_weight"
        android:clipToPadding="false"
        android:padding="8dp" />

</LinearLayout>
