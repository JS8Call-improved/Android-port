<?xml version="1.0" encoding="utf-8"?>
<!--
  Landscape on a tablet. The status strip is short enough now that a side
  column for it would be mostly empty, so it spans the width like it does on
  a phone and the decode list keeps the whole area below.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <!-- Waterfall View, full width -->
    <com.js8call.example.ui.WaterfallView
        android:id="@+id/waterfall_view"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@color/waterfall_background" />

    <!-- Status strip, edge to edge under the waterfall -->
    <include
        layout="@layout/monitor_status_card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <!-- Embedded decode list -->
    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/decode_pane"
        android:name="com.js8call.example.ui.DecodeFragment"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1.3" />

</LinearLayout>
