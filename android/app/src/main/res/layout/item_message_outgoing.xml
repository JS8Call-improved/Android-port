<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingVertical="4dp">

    <!-- Outgoing message bubble (right aligned) -->
    <LinearLayout
        android:id="@+id/bubble_container"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="64dp"
        android:background="@drawable/bubble_outgoing"
        android:orientation="vertical"
        android:paddingHorizontal="12dp"
        android:paddingVertical="8dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="1.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintWidth_max="wrap"
        app:layout_constraintWidth_percent="0.85">

        <!-- Message text -->
        <TextView
            android:id="@+id/message_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textAppearance="?attr/textAppearanceBodyMedium"
            android:textColor="@color/bubble_text_outgoing"
            tools:text="Hey! I'm doing great, thanks for asking." />

        <!-- Which stations carried this one, when it did not go direct -->
        <TextView
            android:id="@+id/relay_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:alpha="0.7"
            android:textAppearance="?attr/textAppearanceLabelSmall"
            android:textColor="@color/bubble_text_outgoing"
            android:visibility="gone"
            tools:text="via KA0XYZ › N0DEF"
            tools:visibility="visible" />

        <!-- Metadata row (timestamp + status) -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:layout_marginTop="4dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/timestamp_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textAppearance="?attr/textAppearanceLabelSmall"
                android:textColor="@color/bubble_text_outgoing"
                android:alpha="0.7"
                tools:text="2:46 PM" />

            <!-- Sending state: Queued / Sending countdown / Failed -->
            <TextView
                android:id="@+id/status_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:textAppearance="?attr/textAppearanceLabelSmall"
                android:textColor="@color/bubble_text_outgoing"
                android:alpha="0.7"
                android:visibility="gone"
                tools:text="Sending 12s"
                tools:visibility="visible" />

            <!-- Status indicator -->
            <ImageView
                android:id="@+id/status_icon"
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:layout_marginStart="4dp"
                android:src="@drawable/ic_send"
                app:tint="@color/bubble_text_outgoing"
                android:alpha="0.7"
                tools:ignore="ContentDescription" />

        </LinearLayout>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
