<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/colorSurface"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingTop="4dp"
    android:paddingEnd="8dp"
    android:paddingBottom="6dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/state_dot"
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:contentDescription="@null"
            android:scaleType="fitCenter"
            android:src="@drawable/status_dot"
            android:tint="@color/message_pending" />

        <TextView
            android:id="@+id/status_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="@string/monitor_state_off"
            android:textAppearance="?attr/textAppearanceTitleMedium"
            tools:text="Receiving" />

        <!-- Only shown when rig control is switched on in Settings -->
        <ImageView
            android:id="@+id/rig_indicator"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:layout_marginStart="8dp"
            android:contentDescription="@string/monitor_rig_disconnected"
            android:src="@drawable/ic_sync_alt"
            android:visibility="gone"
            tools:visibility="visible" />

        <Space
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/frequency_button"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:maxLines="1"
            android:minWidth="0dp"
            android:paddingStart="8dp"
            android:paddingEnd="4dp"
            android:textColor="?attr/colorOnSurfaceVariant"
            app:icon="@drawable/ic_arrow_drop_down"
            app:iconGravity="textEnd"
            app:iconPadding="0dp"
            app:iconTint="?attr/colorOnSurfaceVariant"
            tools:text="20m · 14.078" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/power_switch"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:contentDescription="@string/monitor_toggle"
            android:minHeight="48dp"
            android:saveEnabled="false" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/telemetry_text"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:textAppearance="?attr/textAppearanceLabelMedium"
            android:textColor="?attr/colorOnSurfaceVariant"
            tools:text="-18.0 dB · TX 1500 Hz · +12 ms" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/monitor_overflow"
            style="@style/Widget.Material3.Button.IconButton"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:contentDescription="@string/monitor_more"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            app:icon="@drawable/ic_more_vert"
            app:iconSize="20dp"
            app:iconTint="?attr/colorOnSurfaceVariant" />
    </LinearLayout>

</LinearLayout>
