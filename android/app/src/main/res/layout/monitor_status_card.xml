<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/status_card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardElevation="4dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp">

        <!-- Status Text -->
        <TextView
            android:id="@+id/status_text"
            style="@style/StatusIndicator"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/monitor_status_stopped"
            android:textSize="14sp"
            tools:text="STOPPED" />

        <!-- Status Details Grid -->
        <GridLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:columnCount="2"
            android:rowCount="6">

            <!-- SNR -->
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:text="@string/monitor_snr"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/snr_value"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:text="--"
                android:textSize="12sp"
                tools:text="+5 dB" />

            <!-- Power -->
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:layout_marginTop="4dp"
                android:text="@string/monitor_power"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/power_value"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:layout_marginTop="4dp"
                android:text="--"
                android:textSize="12sp"
                tools:text="-45 dB" />

            <!-- TX Offset -->
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:layout_marginTop="4dp"
                android:text="@string/monitor_tx_offset"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tx_offset_value"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:layout_marginTop="4dp"
                android:text="1500 Hz"
                android:textSize="12sp" />

            <!-- Audio Device -->
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:layout_marginTop="4dp"
                android:text="@string/monitor_audio_device"
                android:textSize="12sp"
                android:textStyle="bold" />

            <Spinner
                android:id="@+id/audio_device_spinner"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:layout_marginTop="4dp"
                android:minHeight="32dp"
                android:spinnerMode="dropdown" />

            <!-- Radio Frequency -->
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:layout_marginTop="4dp"
                android:text="@string/monitor_radio_frequency"
                android:textSize="12sp"
                android:textStyle="bold" />

            <Spinner
                android:id="@+id/frequency_spinner"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:layout_marginTop="4dp"
                android:minHeight="32dp"
                android:spinnerMode="dropdown" />

            <!-- Time Drift -->
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:layout_marginTop="4dp"
                android:layout_gravity="center_vertical"
                android:text="@string/monitor_time_drift"
                android:textSize="12sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/time_drift_value"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="0 ms"
                    android:textSize="12sp"
                    tools:text="+1200 ms" />

                <Button
                    android:id="@+id/time_sync_button"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minWidth="0dp"
                    android:minHeight="32dp"
                    android:paddingHorizontal="8dp"
                    android:text="@string/monitor_time_sync"
                    android:textSize="12sp" />

                <Button
                    android:id="@+id/time_drift_reset_button"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minWidth="0dp"
                    android:minHeight="32dp"
                    android:paddingHorizontal="8dp"
                    android:text="@string/monitor_time_drift_reset"
                    android:textSize="12sp" />
            </LinearLayout>

        </GridLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
