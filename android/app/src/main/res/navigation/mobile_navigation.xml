<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/mobile_navigation"
    app:startDestination="@id/navigation_monitor">

    <fragment
        android:id="@+id/navigation_monitor"
        android:name="com.js8call.example.ui.MonitorFragment"
        android:label="@string/nav_monitor" />

    <fragment
        android:id="@+id/navigation_messages"
        android:name="com.js8call.example.ui.MessagesFragment"
        android:label="@string/nav_messages">
        <action
            android:id="@+id/action_messages_to_conversation"
            app:destination="@id/navigation_conversation" />
        <action
            android:id="@+id/action_messages_to_everything"
            app:destination="@id/navigation_everything" />
        <action
            android:id="@+id/action_messages_to_mailbox"
            app:destination="@id/navigation_mailbox" />
        <action
            android:id="@+id/action_messages_to_other_groups"
            app:destination="@id/navigation_other_groups" />
    </fragment>

    <fragment
        android:id="@+id/navigation_mailbox"
        android:name="com.js8call.example.ui.MailboxFragment"
        android:label="@string/mailbox_title" />

    <fragment
        android:id="@+id/navigation_other_groups"
        android:name="com.js8call.example.ui.OtherGroupsFragment"
        android:label="@string/other_groups_title" />

    <fragment
        android:id="@+id/navigation_everything"
        android:name="com.js8call.example.ui.EverythingFragment"
        android:label="@string/everything_title" />

    <fragment
        android:id="@+id/navigation_conversation"
        android:name="com.js8call.example.ui.ConversationFragment"
        android:label="{callsign}">
        <argument
            android:name="callsign"
            app:argType="string" />
    </fragment>

    <fragment
        android:id="@+id/navigation_contacts"
        android:name="com.js8call.example.ui.ContactsFragment"
        android:label="@string/nav_contacts" />

    <fragment
        android:id="@+id/navigation_settings"
        android:name="com.js8call.example.ui.SettingsFragment"
        android:label="@string/nav_settings" />
</navigation>
